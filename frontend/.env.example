# Copy to frontend/.env.local. All optional; defaults shown.

# Backend. Use http://localhost:8001 for the Phase 7 mock (npm run dev:mock).
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Override contract addresses (otherwise read from src/contracts/localhost.json).
# NEXT_PUBLIC_MOCK_INR_ADDRESS=
# NEXT_PUBLIC_REGISTRY_ADDRESS=
# NEXT_PUBLIC_SETTLEMENT_ADDRESS=
# NEXT_PUBLIC_REPUTATION_ANCHOR_ADDRESS=

# Hide the local demo wallets.
# NEXT_PUBLIC_DISABLE_DEMO_WALLET=true
