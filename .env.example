# Database & Cache
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5433/energy_trading
REDIS_URL=redis://localhost:6379/0

# Blockchain / Hardhat
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Operator & Auth
# Default Hardhat account #0 private key (LOCAL DEMO ONLY — never use on public nets)
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Public placeholder: fine on the local chain only. On any other CHAIN_ID the backend refuses
# to start unless this is a random value of 32+ characters (make demo generates one).
JWT_SECRET=fair_and_trustworthy_jwt_secret_key_change_in_production

# Sign-In With Ethereum: domain and URI shown in the wallet; must match the frontend's site.
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000

# Admin / operator wallets created by the seed script. Required off the local chain, where
# Hardhat demo accounts (whose keys are public) are never seeded.
# ADMIN_ADDRESSES=0xYourAdminWallet
# OPERATOR_ADDRESSES=0xYourOperatorWallet

# Comma-separated browser origins for CORS. Use * only for local demo.
# Production example: https://your-app.vercel.app
CORS_ORIGINS=*

# Market lifecycle (Phase 7)
# Production default is 900s; demo uses 30–60s for fast intervals.
INTERVAL_SECONDS=45
DEMO_MODE=1
DEMO_BOT_COUNT=20
# Optional override; defaults to 1 on localhost, 2 on Sepolia.
# CHAIN_CONFIRMATIONS=1

# Sepolia (optional — local Hardhat is the default demo chain)
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<key>
# ETHERSCAN_API_KEY=

# Contract Addresses (set after deployment; also auto-loaded from
# contracts/deployments/<network>.json when empty)
PING_CONTRACT_ADDRESS=
MOCK_INR_ADDRESS=
REGISTRY_ADDRESS=
REPUTATION_ANCHOR_ADDRESS=
SETTLEMENT_ADDRESS=
